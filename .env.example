# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 GitHub 에 올라가지 않습니다)

# ── 한국투자증권 Open API (필수) ─────────────────────────────
# KIS Developers(apiportal.koreainvestment.com) > 모의투자 신청 후 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# paper = 모의투자(기본), real = 실전 (이 프로그램은 시세 조회만 하며 주문 기능이 없습니다)
KIS_ENV=paper

# ── 선택: 없으면 해당 기능만 건너뜁니다 ─────────────────────
# 공공데이터포털(data.go.kr) > '금융위원회_주식시세정보' 활용신청 후 발급되는 일반 인증키
# (전체 종목 목록·시가총액용. 없으면 네이버 금융 시세로 자동 대체)
DATA_GO_KR_API_KEY=
# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# DART 전자공시 OpenAPI (opendart.fss.or.kr) 인증키
DART_API_KEY=
# 한국은행 ECOS (ecos.bok.or.kr) 인증키
ECOS_API_KEY=

# ── 카카오톡 알림 (선택) ── developers.kakao.com 에서 앱을 만들고 'REST API 키'를 붙여넣기
# 자세한 순서는 README '카카오톡 알림' 참고. 입력 후 kakao_setup.bat 실행
KAKAO_REST_API_KEY=
# 앱의 [보안] 에서 Client Secret 을 '사용함'으로 켠 경우에만
KAKAO_CLIENT_SECRET=

# ── 휴대폰에서 보기 (선택) ── 휴대폰 등 다른 기기에서 대시보드에 들어올 때 묻는 비밀번호
# 비워 두면 다른 기기에서는 '보기 전용'(관심종목 추가·해제 불가). PC 자신은 묻지 않음
DASHBOARD_PASSWORD=
# 카카오 알림 '대시보드 열기' 버튼 주소 (비워 두면 Tailscale 주소를 자동으로 사용)
DASHBOARD_URL=
